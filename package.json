{
  "name": "usage-metering-service",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "npm run build && NODE_ENV=test jasmine",
    "db:seed": "tsx src/db/seed.ts",
    "start": "node dist/src/server.js",
    "db:seed:test": "NODE_ENV=test tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "perf:prepare": "NODE_ENV=test tsx performance/prepare.ts",
    "perf:verify": "NODE_ENV=test tsx performance/verify.ts",
    "perf:cleanup": "NODE_ENV=test tsx performance/cleanup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jasmine": "^7.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "jasmine": "^7.0.0",
    "jasmine-spec-reporter": "^7.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  }
}
