{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "jasmine"]
  },
  "include": [
    "src/**/*.ts",
    "spec/**/*.ts",
    "performance/**/*.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
